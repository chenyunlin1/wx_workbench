# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5174

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=life_workbench
DB_LOGGING=false

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Demo seed
SEED_DEMO_DATA=true

# AI 助手（可留空，改用前端「AI 助手 → 设置」填写）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 高驰 MCP（全部可留空，用内置默认值）
# MCP 接口地址；留空用官方 https://mcp.coros.com/mcp
COROS_MCP_URL=
# OAuth 回调地址；留空按请求的协议+域名推导（跨设备调试时必须填成手机/另一台机器能访问的地址）
COROS_REDIRECT_URI=
# 授权完成后 302 回哪个前端；留空取 CORS_ORIGINS 的第一项
COROS_WEB_URL=